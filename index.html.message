from fastapi import FastAPI, WebSocket, WebSocketDisconnect
from fastapi.responses import HTMLResponse, JSONResponse, Response
from fastapi.middleware.cors import CORSMiddleware
from typing import List, Dict
from datetime import datetime
import json
import uvicorn

app = FastAPI(title="IsmaMessage")

# Разрешаем запросы откуда угодно (чтобы APK мог подключаться)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ============ ХРАНИЛИЩЕ В ПАМЯТИ ============
users: Dict[str, dict] = {}
connections: Dict[str, WebSocket] = {}
messages_db: List[dict] = []
HTML_PAGE = """
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>IsmaMessage</title>
<style>
/* --- ПЕРЕМЕННЫЕ ТЕМ --- */
:root {
  /* Основная (Фиолетовая) */
  --bg-main: linear-gradient(135deg, #4a00e0, #1a0033);
  --bg-panel: rgba(20, 10, 30, 0.95);
  --text-main: #ffffff;
  --text-muted: #b3a8c2;
  --accent: #8e2de2;
  --accent-hover: #4a00e0;
  --msg-own: #6a0dad;
  --msg-other: #2a1b38;
  --border: #3a2b4a;
  --watermark: rgba(255, 255, 255, 0.03);
}

[data-theme="dark"] {
  --bg-main: #121212;
  --bg-panel: #1e1e1e;
  --text-main: #ffffff;
  --text-muted: #aaaaaa;
  --accent: #0088cc;
  --accent-hover: #006699;
  --msg-own: #005c8a;
  --msg-other: #2a2a2a;
  --border: #333333;
  --watermark: rgba(255, 255, 255, 0.02);
}

[data-theme="light"] {
  --bg-main: #f0f2f5;
  --bg-panel: #ffffff;
  --text-main: #000000;
  --text-muted: #666666;
  --accent: #0088cc;
  --accent-hover: #006699;
  --msg-own: #dcf8c6;
  --msg-other: #ffffff;
  --border: #dddddd;
  --watermark: rgba(0, 0, 0, 0.03);
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: var(--bg-main);
  color: var(--text-main);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* Водяной знак на фоне */
body::before {
  content: "IsmaMessage";
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%) rotate(-30deg);
  font-size: 70px;
  font-weight: 900;
  color: var(--watermark);
  white-space: nowrap;
  pointer-events: none;
  z-index: 0;
}

.screen { display: none; flex: 1; flex-direction: column; overflow: hidden; z-index: 1; position: relative; }
.screen.active { display: flex; }

/* --- АВТОРИЗАЦИЯ --- */
#authScreen { padding: 30px 20px; justify-content: center; }
.auth-box {
  background: var(--bg-panel);
  border-radius: 16px;
  padding: 25px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  border: 1px solid var(--border);
  backdrop-filter: blur(10px);
}
.auth-box h2 { text-align: center; margin-bottom: 20px; color: var(--accent); font-size: 24px; }
.auth-box input {
  width: 100%; padding: 14px; margin-bottom: 12px;
  background: rgba(0,0,0,0.2);
  border: 1px solid var(--border); border-radius: 10px;
  font-size: 16px; outline: none; color: var(--text-main);
}
[data-theme="light"] .auth-box input { background: #f9f9f9; }
.auth-box input:focus { border-color: var(--accent); }
.auth-box button {
  width: 100%; padding: 14px; background: var(--accent); color: white;
  border: none; border-radius: 10px; font-size: 16px; font-weight: 600; cursor: pointer;
  transition: 0.2s;
}
.auth-box button:active { background: var(--accent-hover); transform: scale(0.98); }
.auth-toggle { text-align: center; margin-top: 15px; color: var(--accent); font-size: 14px; cursor: pointer; }
.error { color: #ff4d4d; font-size: 13px; text-align: center; margin-bottom: 10px; min-height: 18px; }

/* --- ШАПКА --- */
.header {
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border);
  color: var(--text-main);
  padding: 14px 18px;
  display: flex; justify-content: space-between; align-items: center;
  font-weight: 600; font-size: 18px;
}
.header button { background: none; border: none; color: var(--text-main); font-size: 20px; cursor: pointer; padding: 5px; }

/* --- СПИСОК ЧАТОВ --- */
#chatList { flex: 1; overflow-y: auto; }
.chat-item {
  display: flex; align-items: center; padding: 14px 18px;
  background: var(--bg-panel); border-bottom: 1px solid var(--border); cursor: pointer;
  margin: 5px 10px; border-radius: 12px;
}
.chat-item:active { opacity: 0.8; }
.avatar {
  width: 48px; height: 48px; border-radius: 50%; background: var(--accent);
  color: white; display: flex; align-items: center; justify-content: center;
  font-size: 20px; font-weight: 600; margin-right: 14px; flex-shrink: 0;
}
.chat-info { flex: 1; overflow: hidden; }
.chat-name { font-weight: 600; font-size: 16px; }
.chat-status { font-size: 13px; color: var(--text-muted); margin-top: 2px; }
.chat-status.online { color: #4caf50; }
.empty { text-align: center; padding: 40px 20px; color: var(--text-muted); }

/* --- ДИАЛОГ --- */
#dialogHeader {
  background: var(--bg-panel); border-bottom: 1px solid var(--border);
  color: var(--text-main); padding: 12px 18px;
  display: flex; align-items: center; gap: 12px;
}
#dialogHeader .back { font-size: 28px; cursor: pointer; background: none; border: none; color: var(--text-main); line-height: 1; }
#dialogHeader .title { font-weight: 600; font-size: 17px; }
#dialogHeader .sub { font-size: 12px; color: var(--text-muted); }

#messagesBox { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 8px; }
.msg {
  background: var(--msg-other); padding: 10px 14px; border-radius: 16px;
  max-width: 80%; align-self: flex-start; word-wrap: break-word;
  box-shadow: 0 1px 2px rgba(0,0,0,0.2); font-size: 15px; color: var(--text-main);
  border-bottom-left-radius: 4px;
}
.msg.own { background: var(--msg-own); align-self: flex-end; border-bottom-left-radius: 16px; border-bottom-right-radius: 4px; color: #fff; }
[data-theme="light"] .msg.own { color: #000; }
.msg .time { font-size: 10px; opacity: 0.7; text-align: right; margin-top: 4px; }

.input-area {
  display: flex; padding: 10px; background: var(--bg-panel); gap: 8px;
  border-top: 1px solid var(--border); align-items: center;
}
.input-area input {
  flex: 1; padding: 12px; background: rgba(0,0,0,0.2);
  border: 1px solid var(--border); border-radius: 22px;
  outline: none; font-size: 16px; color: var(--text-main);
}
[data-theme="light"] .input-area input { background: #f9f9f9; }
.input-area button {
  background: var(--accent); color: white; border: none;
  width: 46px; height: 46px; border-radius: 50%; font-size: 20px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}

/* --- МОДАЛКА --- */
#searchModal { position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: none; padding: 20px; z-index: 100; backdrop-filter: blur(5px); }
#searchModal.active { display: flex; align-items: flex-start; justify-content: center; padding-top: 80px; }
.search-box { background: var(--bg-panel); border-radius: 16px; padding: 20px; width: 100%; max-width: 400px; border: 1px solid var(--border); }
.search-box h3 { margin-bottom: 15px; color: var(--accent); }
.search-box input { width: 100%; padding: 12px; background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 10px; font-size: 16px; margin-bottom: 10px; color: var(--text-main); }
[data-theme="light"] .search-box input { background: #f9f9f9; }
.search-box button { width: 100%; padding: 12px; background: var(--accent); color: white; border: none; border-radius: 10px; font-size: 16px; cursor: pointer; margin-bottom: 8px; }
.search-box .close { background: transparent; border: 1px solid var(--border); color: var(--text-main); }
</style>
</head>
<body data-theme="default">

<!-- ЭКРАН ВХОДА -->
<div id="authScreen" class="screen active">
  <div class="auth-box">
    <h2 id="authTitle">Вход</h2>
    <div class="error" id="authError"></div>
    
    <!-- Поле для URL сервера (важно для APK) -->
    <input type="text" id="serverUrl" placeholder="URL сервера (напр. https://mysite.com)" value="">
    
    <input type="text" id="authUser" placeholder="Имя пользователя (логин)">
    <input type="password" id="authPass" placeholder="Пароль">
    <input type="text" id="authExtra" placeholder="Email или телефон" style="display:none;">
    <button onclick="doAuth()" id="authBtn">Войти</button>
    <div class="auth-toggle" onclick="toggleAuth()" id="authToggle">Нет аккаунта? Зарегистрироваться</div>
  </div>
</div>

<!-- ЭКРАН СПИСКА ЧАТОВ -->
<div id="listScreen" class="screen">
  <div class="header">
    <span>💬 IsmaMessage</span>
    <div style="display:flex;gap:10px;">
      <button onclick="toggleTheme()" title="Сменить тему">🌓</button>
      <button onclick="openSearch()" title="Новый чат">➕</button>
      <button onclick="logout()" title="Выйти">⎋</button>
    </div>
  </div>
  <div id="chatList"></div>
</div>

<!-- ЭКРАН ДИАЛОГА -->
<div id="dialogScreen" class="screen">
  <div id="dialogHeader">
    <button class="back" onclick="closeDialog()">‹</button>
    <div>
      <div class="title" id="dialogTitle">—</div>
      <div class="sub" id="dialogStatus">—</div>
    </div>
  </div>
  <div id="messagesBox"></div>
  <div class="input-area">
    <input type="text" id="msgInput" placeholder="Сообщение..." autocomplete="off">
    <button onclick="sendMsg()">➤</button>
  </div>
</div>

<!-- МОДАЛКА ПОИСКА -->
<div id="searchModal">
  <div class="search-box">
    <h3>Начать чат</h3>
    <input type="text" id="searchInput" placeholder="Имя пользователя">
    <button onclick="startChat()">Открыть чат</button>
    <button class="close" onclick="closeSearch()">Отмена</button>
  </div>
</div>
<script>
let currentUser = localStorage.getItem('currentUser') || '';
let currentChat = null;
let ws = null;
let isRegister = false;
let apiBase = localStorage.getItem('apiBase') || window.location.origin;

// Инициализация темы и URL
if (localStorage.getItem('theme')) {
  document.body.setAttribute('data-theme', localStorage.getItem('theme'));
}
document.getElementById('serverUrl').value = apiBase;

function toggleTheme() {
  const current = document.body.getAttribute('data-theme');
  let next = 'default';
  if (current === 'default') next = 'dark';
  else if (current === 'dark') next = 'light';
  localStorage.setItem('theme', next);
  document.body.setAttribute('data-theme', next);
}

function toggleAuth() {
  isRegister = !isRegister;
  document.getElementById('authTitle').textContent = isRegister ? 'Регистрация' : 'Вход';
  document.getElementById('authBtn').textContent = isRegister ? 'Зарегистрироваться' : 'Войти';
  document.getElementById('authToggle').textContent = isRegister ? 'Уже есть аккаунт? Войти' : 'Нет аккаунта? Зарегистрироваться';
  document.getElementById('authExtra').style.display = isRegister ? 'block' : 'none';
  document.getElementById('authError').textContent = '';
}

async function doAuth() {
  const user = document.getElementById('authUser').value.trim();
  const pass = document.getElementById('authPass').value.trim();
  const extra = document.getElementById('authExtra').value.trim();
  let urlInput = document.getElementById('serverUrl').value.trim();
  
  // Убираем слэш в конце, если есть
  if (urlInput.endsWith('/')) urlInput = urlInput.slice(0, -1);
  apiBase = urlInput;
  localStorage.setItem('apiBase', apiBase);

  const err = document.getElementById('authError');

  if (!user || !pass) { err.textContent = 'Введите логин и пароль'; return; }
  if (isRegister && !extra) { err.textContent = 'Укажите email или телефон'; return; }

  const url = isRegister ? apiBase + '/api/register' : apiBase + '/api/login';
  const body = isRegister ? { username: user, password: pass, contact: extra } : { username: user, password: pass };

  err.textContent = 'Загрузка...';
  try {
    const r = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const data = await r.json();
    if (!r.ok) { err.textContent = data.detail || 'Ошибка'; return; }
    currentUser = user;
    localStorage.setItem('currentUser', user);
    enterApp();
  } catch(e) { err.textContent = 'Сервер недоступен (проверь URL)'; }
}

function logout() {
  localStorage.removeItem('currentUser');
  currentUser = '';
  if (ws) ws.close();
  document.getElementById('listScreen').classList.remove('active');
  document.getElementById('authScreen').classList.add('active');
  document.getElementById('authError').textContent = '';
}

function enterApp() {
  document.getElementById('authScreen').classList.remove('active');
  document.getElementById('listScreen').classList.add('active');
  connectWS();
  loadChats();
}

function connectWS() {
  let wsProto = apiBase.startsWith('https') ? 'wss://' : 'ws://';
  let wsHost = apiBase.replace('https://', '').replace('http://', '');
  ws = new WebSocket(wsProto + wsHost + '/ws/' + currentUser);
  
  ws.onopen = () => console.log('WS connected');
  ws.onmessage = (e) => {
    const data = JSON.parse(e.data);
    if (data.type === 'message') {
      if (currentChat === data.from || currentChat === data.to) {
        if (data.from === currentChat) addMessage(data.text, false, data.time);
      }
      loadChats();
    }
    if (data.type === 'status') {
      if (currentChat === data.username) updateStatus(data.online);
      loadChats();
    }
  };
  ws.onclose = () => setTimeout(() => { if (currentUser) connectWS(); }, 3000);
}

async function loadChats() {
  try {
    const r = await fetch(apiBase + '/api/chats/' + currentUser);
    const chats = await r.json();
    const box = document.getElementById('chatList');
    if (!chats.length) { box.innerHTML = '<div class="empty">Пока нет чатов.<br>Нажми ➕ чтобы найти друга.</div>'; return; }
    box.innerHTML = chats.map(c => `
      <div class="chat-item" onclick="openDialog('${c.username}')">
        <div class="avatar">${c.username[0].toUpperCase()}</div>
        <div class="chat-info">
          <div class="chat-name">${c.username}</div>
          <div class="chat-status ${c.online ? 'online' : ''}">${c.online ? 'онлайн' : (c.last_seen || 'был(а) недавно')}</div>
        </div>
      </div>
    `).join('');
  } catch(e) { console.error(e); }
}

function openSearch() { document.getElementById('searchModal').classList.add('active'); document.getElementById('searchInput').focus(); }
function closeSearch() { document.getElementById('searchModal').classList.remove('active'); document.getElementById('searchInput').value = ''; }
function startChat() {
  const u = document.getElementById('searchInput').value.trim();
  if (!u) return;
  if (u === currentUser) { alert('Это ты :)'); return; }
  closeSearch();
  openDialog(u);
}

async function openDialog(username) {
  currentChat = username;
  document.getElementById('listScreen').classList.remove('active');
  document.getElementById('dialogScreen').classList.add('active');
  document.getElementById('dialogTitle').textContent = username;
  document.getElementById('messagesBox').innerHTML = '';
  document.getElementById('dialogStatus').textContent = 'загрузка...';

  try {
    const r = await fetch(`${apiBase}/api/history/${currentUser}/${username}`);
    const msgs = await r.json();
    msgs.forEach(m => addMessage(m.text, m.from === currentUser, m.time));
    document.getElementById('messagesBox').scrollTop = 999999;
  } catch(e) {}

  try {
    const r = await fetch(apiBase + '/api/status/' + username);
    const s = await r.json();
    updateStatus(s.online, s.last_seen);
  } catch(e) {}
}

function closeDialog() {
  currentChat = null;
  document.getElementById('dialogScreen').classList.remove('active');
  document.getElementById('listScreen').classList.add('active');
  loadChats();
}

function updateStatus(online, lastSeen) {
  const el = document.getElementById('dialogStatus');
  el.textContent = online ? 'онлайн' : (lastSeen || 'был(а) недавно');
  el.style.color = online ? '#4caf50' : '';
}

function addMessage(text, own, time) {
  const box = document.getElementById('messagesBox');
  const div = document.createElement('div');
  div.className = 'msg' + (own ? ' own' : '');
  div.innerHTML = `${escapeHtml(text)}<div class="time">${time || ''}</div>`;
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
}

function escapeHtml(t) {
  return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function sendMsg() {
  const inp = document.getElementById('msgInput');
  const text = inp.value.trim();
  if (!text || !currentChat) return;
  const time = new Date().toLocaleTimeString('ru-RU', {hour:'2-digit', minute:'2-digit'});
  ws.send(JSON.stringify({ type: 'message', to: currentChat, text: text, time: time }));
  addMessage(text, true, time);
  inp.value = '';
}

document.getElementById('msgInput').addEventListener('keypress', e => { if (e.key === 'Enter') sendMsg(); });

if (currentUser) { enterApp(); }
</script>
</body>
</html>
"""
# ============ РЕГИСТРАЦИЯ / ЛОГИН ============
@app.post("/api/register")
async def register(data: dict):
    username = data.get("username", "").strip()
    password = data.get("password", "").strip()
    contact = data.get("contact", "").strip()
    if not username or not password or not contact:
        return JSONResponse({"detail": "Все поля обязательны"}, status_code=400)
    if username in users:
        return JSONResponse({"detail": "Такой пользователь уже есть"}, status_code=400)
    users[username] = {"password": password, "contact": contact, "last_seen": None}
    return {"ok": True}

@app.post("/api/login")
async def login(data: dict):
    username = data.get("username", "").strip()
    password = data.get("password", "").strip()
    if username not in users:
        return JSONResponse({"detail": "Пользователь не найден"}, status_code=404)
    if users[username]["password"] != password:
        return JSONResponse({"detail": "Неверный пароль"}, status_code=401)
    return {"ok": True}

# ============ СПИСОК ЧАТОВ ============
@app.get("/api/chats/{username}")
async def get_chats(username: str):
    partners = set()
    for m in messages_db:
        if m["from"] == username: partners.add(m["to"])
        elif m["to"] == username: partners.add(m["from"])
    result = []
    for p in partners:
        online = p in connections
        last_seen = users.get(p, {}).get("last_seen")
        result.append({"username": p, "online": online, "last_seen": last_seen})
    return result

# ============ ИСТОРИЯ ============
@app.get("/api/history/{user1}/{user2}")
async def get_history(user1: str, user2: str):
    return [m for m in messages_db
            if (m["from"] == user1 and m["to"] == user2) or
               (m["from"] == user2 and m["to"] == user1)]

# ============ СТАТУС ============
@app.get("/api/status/{username}")
async def get_status(username: str):
    return {"online": username in connections, "last_seen": users.get(username, {}).get("last_seen")}

# ============ ГЛАВНАЯ ============
@app.get("/")
async def index():
    return HTMLResponse(HTML_PAGE)

@app.get("/manifest.json")
async def manifest():
    return {
        "name": "IsmaMessage", "short_name": "IsmaMsg",
        "start_url": "/", "display": "standalone",
        "background_color": "#1a0033", "theme_color": "#8e2de2",
        "icons": [{"src": "/icon.png", "sizes": "192x192", "type": "image/png"}]
    }

@app.get("/icon.png")
async def icon():
    import base64
    png = base64.b64decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==")
    return Response(content=png, media_type="image/png")
    # ============ WEBSOCKET ============
@app.websocket("/ws/{username}")
async def websocket_endpoint(websocket: WebSocket, username: str):
    await websocket.accept()
    connections[username] = websocket
    
    for other_ws in connections.values():
        try:
            await other_ws.send_text(json.dumps({"type": "status", "username": username, "online": True}))
        except: pass

    try:
        while True:
            raw = await websocket.receive_text()
            data = json.loads(raw)
            if data.get("type") == "message":
                msg = {
                    "from": username, "to": data["to"],
                    "text": data["text"], "time": data.get("time", "")
                }
                messages_db.append(msg)
                if msg["to"] in connections:
                    try:
                        await connections[msg["to"]].send_text(json.dumps({"type": "message", **msg}, ensure_ascii=False))
                    except: pass
    except WebSocketDisconnect:
        if username in connections: del connections[username]
        users[username]["last_seen"] = datetime.now().strftime("%H:%M")
        for other_ws in connections.values():
            try:
                await other_ws.send_text(json.dumps({"type": "status", "username": username, "online": False}))
            except: pass

# ============ ЗАПУСК ============
if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=8000)